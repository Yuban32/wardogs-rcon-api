#!/usr/bin/env sh
# shellcheck shell=sh

# Conventional Commits, checked but not enforced.
#
# `type: subject` is what makes a commit history scannable and what a changelog
# generator can group. The check warns rather than refuses: a message that does
# not match can still be a perfectly clear one, and a hook that blocks a commit
# over punctuation teaches people to reach for `--no-verify` — which disables
# the typecheck and test hooks too. A warning carries the same information and
# costs nothing when it is wrong.
#
# Warnings go to stderr and the script still exits 0, so the commit proceeds.
# To make this blocking instead, change the final `exit 0` to `exit 1`.

set -e

message_file="$1"

# The full message, comments excluded. `--no-merges` via the caller is not
# available here, so a merge commit is recognised by its own shape below.
message=$(sed '/^#/d' "$message_file")

# Merge and revert commits are generated by git and are not the author's
# wording, so there is nothing to advise about.
if printf '%s' "$message" | head -n 1 | grep -qE '^(Merge|Revert|fixup!|squash!)'; then
  exit 0
fi

subject=$(printf '%s' "$message" | head -n 1)

# `type(optional-scope)!: subject` — the types this project uses.
pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^)]+\))?!?: .+'

if ! printf '%s' "$subject" | grep -qE "$pattern"; then
  echo "" >&2
  echo "  ! commit subject does not follow Conventional Commits" >&2
  echo "" >&2
  echo "      $subject" >&2
  echo "" >&2
  echo "    expected: type(scope): subject" >&2
  echo "    types:    build chore ci docs feat fix perf refactor revert style test" >&2
  echo "    example:  feat(watcher): expose the last snapshot locally" >&2
  echo "" >&2
  echo "    This is a warning — the commit will proceed. Use \`--no-verify\` to" >&2
  echo "    silence it, but that also skips the typecheck and test hooks." >&2
  echo "" >&2
fi

# A changelog that lags a release is worse than no changelog: it tells a reader
# the notes are complete when they are not. `npm run check:changelog` proves the
# two agree, so the reminder is only about whether this commit changes the
# version — which is what makes the changelog stale.
if git diff --cached --name-only | grep -qE '^package\.json$'; then
  if ! git diff --cached package.json | grep -qE '^[+-]\s*"version"'; then
    : # package.json changed for some other reason; nothing to say.
  elif ! git diff --cached --name-only | grep -qE 'CHANGELOG'; then
    echo "" >&2
    echo "  ! package.json version changed but no CHANGELOG entry is staged" >&2
    echo "" >&2
    echo "    npm run check:changelog will fail on this. Add the version to" >&2
    echo "    CHANGELOG.md and CHANGELOG.zh-CN.md before tagging." >&2
    echo "" >&2
  fi
fi

exit 0
