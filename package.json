{
  "name": "@yuban32/wardogs-rcon-api",
  "version": "0.1.0",
  "description": "Typed client and utilities for the Wardogs dedicated server RCON HTTP API (/v1). ESM + CJS + UMD, zero runtime dependencies, works in Node, Bun, Deno and the browser.",
  "author": "Yuban32",
  "keywords": [
    "wardogs",
    "rcon",
    "api",
    "client",
    "typescript",
    "dedicated-server",
    "game-server"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuban32/wardogs-rcon-api.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/wardogs-rcon-api.umd.js",
  "jsdelivr": "./dist/wardogs-rcon-api.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./umd": "./dist/wardogs-rcon-api.umd.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:esm": "vite build",
    "build:umd": "vite build --config vite.umd.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:pkg": "node scripts/check-exports.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build && npm run lint:pkg",
    "prepare": "husky || true",
    "prepublishOnly": "npm run verify"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "msw": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^2.1.0"
  }
}
