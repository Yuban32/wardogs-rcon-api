# Build output — regenerated by `npm run build`, so formatting it is pointless
# and makes every build look like a diff.
dist/
coverage/

# Dependencies
node_modules/

# A snapshot of the community-published OpenAPI spec, fetched from
# wardogs.tech and redistributed verbatim. Reformatting it would obscure the
# difference between what the server actually publishes and what we wrote —
# which is the one thing that file exists to preserve. `scripts/build.mjs` and
# a conformance test read it; neither cares about whitespace.
spec/

# A lockfile's layout belongs to the tool that writes it; reformatting it fights
# that tool. The library is installed with npm and the `web/` panel with pnpm,
# so both names appear here — see `web/package.json` and the `panel` job in CI.
package-lock.json
pnpm-lock.yaml

